{
  "getCurrentUserInfo": "optitech me",
  "createNeonAuth": "optitech optitech-auth enable",
  "getNeonAuth": "optitech optitech-auth status",
  "disableNeonAuth": "optitech optitech-auth disable",
  "listBranchNeonAuthOauthProviders": "optitech optitech-auth oauth-provider list",
  "addBranchNeonAuthOauthProvider": "optitech optitech-auth oauth-provider add",
  "updateBranchNeonAuthOauthProvider": "optitech optitech-auth oauth-provider update",
  "deleteBranchNeonAuthOauthProvider": "optitech optitech-auth oauth-provider delete",
  "listBranchNeonAuthTrustedDomains": "optitech optitech-auth domain list",
  "addBranchNeonAuthTrustedDomain": "optitech optitech-auth domain add <domain>",
  "deleteBranchNeonAuthTrustedDomain": "optitech optitech-auth domain delete <domain>",
  "getNeonAuthAllowLocalhost": "optitech optitech-auth domain allow-localhost get",
  "updateNeonAuthAllowLocalhost": {
    "commands": [
      {
        "cmd": "optitech optitech-auth domain allow-localhost enable",
        "covers": ["allow_localhost"]
      },
      {
        "cmd": "optitech optitech-auth domain allow-localhost disable",
        "covers": ["allow_localhost"]
      }
    ],
    "uncovered": []
  },
  "getNeonAuthEmailAndPasswordConfig": "optitech optitech-auth config email-password get",
  "updateNeonAuthEmailAndPasswordConfig": "optitech optitech-auth config email-password update",
  "getNeonAuthEmailProvider": "optitech optitech-auth config email-provider get",
  "updateNeonAuthEmailProvider": "optitech optitech-auth config email-provider update",
  "sendNeonAuthTestEmail": "optitech optitech-auth config email-provider test",
  "getNeonAuthPluginConfigs": {
    "commands": [
      {
        "cmd": "optitech optitech-auth plugins list",
        "covers": []
      },
      {
        "cmd": "optitech optitech-auth plugins get <plugin-name>",
        "covers": []
      },
      {
        "cmd": "optitech optitech-auth config organization get",
        "covers": []
      }
    ],
    "uncovered": []
  },
  "updateNeonAuthOrganizationPlugin": "optitech optitech-auth config organization update",
  "getNeonAuthWebhookConfig": "optitech optitech-auth config webhook get",
  "updateNeonAuthWebhookConfig": "optitech optitech-auth config webhook update",
  "createBranchNeonAuthNewUser": "optitech optitech-auth user create",
  "deleteBranchNeonAuthUser": "optitech optitech-auth user delete <user-id>",
  "updateNeonAuthUserRole": "optitech optitech-auth user set-role <user-id>",
  "getCurrentUserOrganizations": "optitech orgs list",
  "listProjects": "optitech projects list",
  "listSharedProjects": "optitech projects list",
  "createProject": "optitech projects create",
  "deleteProject": "optitech projects delete",
  "updateProject": "optitech projects update",
  "recoverProject": "optitech projects recover",
  "getProject": "optitech projects get",
  "listOrganizationVPCEndpoints": "optitech vpc endpoint list --org-id <id> --region-id <region_id>",
  "deleteOrganizationVPCEndpoint": "optitech vpc endpoint remove <vpc_endpoint_id> --org-id <id> --region-id <region_id>",
  "getOrganizationVPCEndpointDetails": "optitech vpc endpoint status <vpc_endpoint_id> --org-id <id> --region-id <region_id>",
  "listProjectVPCEndpoints": "optitech vpc project list --project-id <id>",
  "deleteProjectVPCEndpoint": "optitech vpc project remove <vpc_endpoint_id> --project-id <id>",
  "listProjectBranches": "optitech branches list",
  "createProjectBranch": "optitech branches create",
  "updateProjectBranch": {
    "commands": [
      {
        "cmd": "optitech branches rename <id|name> <new-name>",
        "covers": ["name"]
      },
      {
        "cmd": "optitech branches set-expiration <id|name>",
        "covers": ["expires_at"]
      }
    ],
    "uncovered": ["protected"]
  },
  "setDefaultProjectBranch": "optitech branches set-default <id|name>",
  "deleteProjectBranch": "optitech branches delete",
  "getProjectBranch": "optitech branches get <id|name>",
  "createProjectEndpoint": "optitech branches add-compute <id|name>",
  "restoreProjectBranch": "optitech branches restore <id|name>",
  "listProjectBranchDatabases": "optitech connection-string [branch] list",
  "listProjectBranchRoles": "optitech connection-string [branch] list",
  "createProjectBranchDatabase": "optitech databases create",
  "deleteProjectBranchDatabase": "optitech databases delete",
  "createProjectBranchRole": "optitech roles create",
  "deleteProjectBranchRole": "optitech roles delete",
  "listProjectOperations": "optitech operations list",
  "getProjectBranchSchema": "optitech branches schema-diff [base] [compare]",
  "getConnectionURI": "optitech connection-string [branch]",
  "assignOrganizationVPCEndpoint": "optitech vpc endpoint assign <vpc_endpoint_id> --org-id <id> --region-id <region_id>",
  "assignProjectVPCEndpoint": "optitech vpc project restrict <vpc_endpoint_id> --project-id <id>"
}
